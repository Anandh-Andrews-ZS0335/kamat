# Copy to .env. Never commit .env.

# --- Bank application (separate service) -------------------------------------
BANK_API_URL=http://127.0.0.1:8001

# --- LLM for the Explanation Agent -------------------------------------------
# Only template *drafting* uses the LLM; it never sees account data and never writes numbers.
# Leave GEMINI_API_KEY empty to run on deterministic templates (shown as "template" in the consoles).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=45

# --- Engine ---------------------------------------------------------------------
# Secret for HMAC tokenisation of account and member identifiers. Change it outside local demos.
LASTMILE_TOKEN_SECRET=dev-only-token-secret-change-me

# --- Sign-in ----------------------------------------------------------------------
# Every console and API needs a login (roles: admin, manager, guest). Generate accounts with `make users`
# and paste the two lines it prints here. With no accounts nobody can sign in.
LASTMILE_USERS=
LASTMILE_SESSION_SECRET=
