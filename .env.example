# Copy to .env. Never commit .env.

# --- Bank application (separate service) -------------------------------------
BANK_API_URL=http://127.0.0.1:8001

# --- LLM for the Explanation & Onboarding Agents -------------------------------------------
# Only template *drafting* and schema mapping use the LLM; it never sees customer data and never writes numbers.
# Options for LLM_PROVIDER: 'gemini', 'ollama', 'none'
# Leave keys empty or set LLM_PROVIDER=none to run on deterministic templates.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For local Ollama (set LLM_PROVIDER=ollama):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_S=60

# --- Engine ---------------------------------------------------------------------
# Secret for HMAC tokenisation of account and member identifiers. Change it outside local demos.
LASTMILE_TOKEN_SECRET=dev-only-token-secret-change-me

# --- Sign-in ----------------------------------------------------------------------
# Every console and API needs a login (roles: admin, manager, guest). Generate accounts with `make users`
# and paste the two lines it prints here. With no accounts nobody can sign in.
LASTMILE_USERS=
LASTMILE_SESSION_SECRET=
