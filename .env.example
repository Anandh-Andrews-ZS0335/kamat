# Copy to .env. Never commit .env.

# --- Bank applications (separate services) -----------------------------------
BANK_API_URL=http://127.0.0.1:8001
HARBOR_COMMUNITY_BANK_API_URL=http://127.0.0.1:8002

# --- Language model, for the Explanation and Onboarding Agents ----------------
# Two places use it: drafting the wording of a recommendation, and proposing a
# column mapping when a new bank is onboarded. It never sees customer data and is
# never allowed to write a number.
# LLM_PROVIDER: 'gemini' or 'ollama'. Anything else runs on deterministic
# templates, and the consoles say so.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For a local Ollama model (set LLM_PROVIDER=ollama) - nothing leaves the machine:
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_S=45

# --- Engine -------------------------------------------------------------------
# HMAC secret that turns account and member ids into tokens. Change it outside a
# local demo: it is what keeps the analytics store free of real identifiers.
LASTMILE_TOKEN_SECRET=dev-only-token-secret-change-me

# Optional overrides:
# LASTMILE_CONFIG_DIR=./config
# LASTMILE_DATA_DIR=./data/engine
# BANK_DATA_DIR=./data/bank

# --- Sign-in ------------------------------------------------------------------
# Every console and API call needs a login. Roles: admin, manager, collector.
# Run `make users` and paste the two lines it prints here. With no accounts,
# nobody can sign in.
#
# A collection agent must be linked to a roster collector id (such as C01), which
# an env account cannot carry - create those from Users & access (/admin/users).
LASTMILE_USERS=
LASTMILE_SESSION_SECRET=
